---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Calendar, ArrowRight } from 'lucide-astro';
import blog from '../data/blog.json';

// Sort blog posts by date (newest first)
const posts = [...blog].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

function formatDate(dateString: string) {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
}
---

<Layout 
  title="Blog — Farras Jibran" 
  description="Thoughts on technology, AI updates, and software development insights."
>
  <div class="grain">
    <Nav />
    <main id="main" class="pt-32 pb-20 sm:pt-40 sm:pb-32">
      <!-- Hero section -->
      <section class="relative">
        <div class="container-page">
          <div data-reveal class="mb-16 flex flex-col gap-6">
            <div>
              <h1
                class="font-sans text-4xl font-bold leading-[1.05] tracking-tight text-accent-500 sm:text-5xl lg:text-6xl"
              >
                Blog
              </h1>
              <p
                class="mt-4 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-400"
              >
                My thoughts on technology, AI updates, and lessons learned building software at scale.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Blog posts grid -->
      <section class="pb-20 sm:pb-32">
        <div class="container-page">
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post, idx) => (
              <article
                data-reveal
                data-reveal-delay={String((idx % 3) + 1)}
                class="group relative overflow-hidden rounded-xl border border-neutral-200 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-neutral-300 hover:shadow-xl dark:border-neutral-800 dark:bg-neutral-900/50 dark:hover:border-neutral-700 dark:hover:shadow-2xl dark:hover:shadow-accent-500/5"
              >
                <div class="mb-4 flex items-start justify-between gap-4">
                  <div class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
                    <Calendar class="h-3.5 w-3.5" />
                    <time datetime={post.date}>{formatDate(post.date)}</time>
                  </div>
                </div>

                <h2 class="mb-3 text-xl font-semibold text-neutral-900 dark:text-neutral-50">
                  {post.title}
                </h2>

                <p class="mb-4 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
                  {post.excerpt}
                </p>

                <div class="mb-5 flex flex-wrap gap-2">
                  {post.tags.map((tag) => (
                    <span
                      class="rounded-md bg-neutral-100 px-2 py-1 font-mono text-xs text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300"
                    >
                      {tag}
                    </span>
                  ))}
                </div>

                <a
                  href={`/blog/${post.slug}`}
                  class="group/link inline-flex items-center gap-2 text-sm font-semibold text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-400 dark:hover:text-accent-300"
                >
                  Read more
                  <ArrowRight class="h-4 w-4 transition-transform group-hover/link:translate-x-0.5" />
                </a>
              </article>
            ))}
          </div>

          {posts.length === 0 && (
            <div class="py-20 text-center">
              <p class="text-neutral-500 dark:text-neutral-400">
                No blog posts yet. Check back soon!
              </p>
            </div>
          )}
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Layout>
