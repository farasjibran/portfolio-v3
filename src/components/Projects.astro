---
import projects from '../data/projects.json';
---

<section id="projects" class="section">
  <div class="container-page">
    <div data-reveal class="mb-16 flex items-end justify-between">
      <div>
        <h2
          class="font-mono text-xs uppercase tracking-wider text-accent-600 dark:text-accent-400"
        >
          Selected Work
        </h2>
        <h3
          class="mt-2 text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50 sm:text-4xl"
        >
          Case studies
        </h3>
      </div>
      <p
        class="hidden max-w-xs text-right text-sm text-neutral-500 dark:text-neutral-400 sm:block"
      >
        5 strongest projects. Each one shipped, in production, used by real people.
      </p>
    </div>

    <!-- Bento grid: first card spans 2 cols on lg -->
    <div class="grid gap-6 lg:grid-cols-2">
      {projects.map((p, idx) => (
        <article
          data-reveal
          data-reveal-delay={String((idx % 3) + 1)}
          class:list={[
            'group relative overflow-hidden rounded-xl border border-neutral-200 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-neutral-300 hover:shadow-xl dark:border-neutral-800 dark:bg-neutral-900/50 dark:hover:border-neutral-700 dark:hover:shadow-2xl dark:hover:shadow-accent-500/5',
            idx === 0 && 'lg:col-span-2 lg:p-8',
          ]}
        >
          <div class="mb-4 flex items-start justify-between gap-4">
            <div class="min-w-0 flex-1">
              <div class="mb-2 flex items-center gap-2">
                <span
                  class:list={[
                    'inline-flex items-center rounded-md border px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider',
                    p.client
                      ? 'border-neutral-200 bg-neutral-50 text-neutral-700 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300'
                      : 'border-dashed border-accent-400/40 bg-accent-50 text-accent-700 dark:border-accent-400/30 dark:bg-accent-950/30 dark:text-accent-300',
                  ]}
                >
                  {p.client ?? 'Personal'}
                </span>
                <span class="font-mono text-xs text-neutral-500 dark:text-neutral-500">
                  · {p.year}
                </span>
              </div>
              <h4 class="text-xl font-semibold text-neutral-900 dark:text-neutral-50">
                {p.name}
              </h4>
              <p
                class="mt-1 font-mono text-xs uppercase tracking-wider text-neutral-500 dark:text-neutral-500"
              >
                {p.role}
              </p>
            </div>
            {(p.liveUrl || p.repoUrl) && (
              <div class="flex shrink-0 gap-2">
                {p.liveUrl && (
                  <a
                    href={p.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 rounded-md border border-neutral-200 px-2.5 py-1 font-mono text-xs text-neutral-700 transition-colors hover:border-accent-500 hover:text-accent-600 dark:border-neutral-800 dark:text-neutral-300 dark:hover:border-accent-400 dark:hover:text-accent-400"
                  >
                    Live <span aria-hidden="true">↗</span>
                  </a>
                )}
                {p.repoUrl && (
                  <a
                    href={p.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 rounded-md border border-neutral-200 px-2.5 py-1 font-mono text-xs text-neutral-700 transition-colors hover:border-accent-500 hover:text-accent-600 dark:border-neutral-800 dark:text-neutral-300 dark:hover:border-accent-400 dark:hover:text-accent-400"
                  >
                    Code <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            )}
          </div>

          <p class="mb-4 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
            {p.summary}
          </p>

          <!-- Problem/Solution/Impact — only on featured/spanning card to avoid bloat -->
          {idx === 0 && (
            <div
              class="mt-6 grid gap-4 border-t border-neutral-200 pt-6 text-sm dark:border-neutral-800 sm:grid-cols-3"
            >
              <div>
                <p
                  class="mb-1.5 font-mono text-[10px] uppercase tracking-wider text-neutral-500 dark:text-neutral-500"
                >
                  Problem
                </p>
                <p class="text-neutral-700 dark:text-neutral-300">{p.problem}</p>
              </div>
              <div>
                <p
                  class="mb-1.5 font-mono text-[10px] uppercase tracking-wider text-neutral-500 dark:text-neutral-500"
                >
                  Solution
                </p>
                <p class="text-neutral-700 dark:text-neutral-300">{p.solution}</p>
              </div>
              <div>
                <p
                  class="mb-1.5 font-mono text-[10px] uppercase tracking-wider text-accent-600 dark:text-accent-400"
                >
                  Impact
                </p>
                <p class="text-neutral-700 dark:text-neutral-300">{p.impact}</p>
              </div>
            </div>
          )}

          <div class="mt-5 flex flex-wrap gap-2">
            {p.tags.map((t) => (
              <span
                class="rounded-md bg-neutral-100 px-2 py-1 font-mono text-xs text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300"
              >
                {t}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
