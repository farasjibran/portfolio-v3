---
import { personal } from "../data/site.json";
---

<section id="about" class="section">
    <div class="container-page">
        <div data-reveal class="grid gap-12 md:grid-cols-[200px_1fr] md:gap-16">
            <div>
                <h2
                    class="font-mono text-xs uppercase tracking-wider text-accent-600 dark:text-accent-400"
                >
                    About
                </h2>
            </div>
            <div
                class="space-y-5 text-base leading-relaxed text-neutral-700 dark:text-neutral-300 sm:text-lg"
            >
                <p>
                    I'm a <strong
                        class="font-semibold text-neutral-900 dark:text-neutral-50"
                        >software engineer based in {personal.location}</strong
                    > with 5+ years shipping production systems for Indonesia's government
                    sector.
                </p>
                <p>
                    Currently at <strong
                        class="font-semibold text-neutral-900 dark:text-neutral-50"
                        >Informatika Media Pratama</strong
                    >, I lead development on platforms used by thousands of
                    ministry employees across KEMENAG and KEMENKES — from
                    cross-platform super-apps to real-time tracking systems.
                </p>
                <p>
                    I'm passionate about <span
                        class="text-accent-600 dark:text-accent-400"
                        >scalable architecture</span
                    >, developer experience, and the intersection of <span
                        class="text-accent-600 dark:text-accent-400"
                        >AI + software engineering</span
                    >.
                </p>
            </div>
        </div>
    </div>
</section>
