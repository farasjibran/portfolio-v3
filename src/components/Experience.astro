---
import experience from '../data/experience.json';
import { Briefcase, MapPin } from 'lucide-astro';
---

<section id="experience" class="section">
  <div class="container-page">
    <div data-reveal class="mb-16">
      <h2
        class="font-mono text-xs uppercase tracking-wider text-accent-600 dark:text-accent-400"
      >
        Experience
      </h2>
      <h3
        class="mt-2 text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50 sm:text-4xl"
      >
        Where I've worked
      </h3>
    </div>

    <div class="relative mx-auto max-w-3xl">
      <!-- Vertical line: positioned at dot center (20px from container left) -->
      <div
        aria-hidden="true"
        class="absolute top-2 bottom-2 w-px bg-neutral-200 left-5 -translate-x-1/2 dark:bg-neutral-800"
      >
      </div>

      <ol class="space-y-12">
        {experience.map((job, idx) => (
          <li
            data-reveal
            data-reveal-delay={String((idx % 3) + 1)}
            class="relative pl-14"
          >
            <!-- Timeline dot: same x-position as line, both share container origin -->
            {job.current ? (
              <span
                aria-hidden="true"
                class="absolute top-1.5 left-5 -translate-x-1/2 h-5 w-5"
              >
                <!-- Ping layer: scales 2x and fades out -->
                <span class="absolute inset-0 rounded-full bg-accent-500 animate-ping"></span>
                <!-- Solid dot on top -->
                <span class="absolute inset-0 rounded-full bg-accent-500 border-4 border-white dark:border-neutral-950 shadow-[0_0_0_3px_rgb(59,130,246,0.25)]"></span>
              </span>
            ) : (
              <span
                aria-hidden="true"
                class="absolute top-1.5 left-5 -translate-x-1/2 h-5 w-5 rounded-full border-4 border-white dark:border-neutral-950 bg-neutral-300 dark:bg-neutral-700"
              >
              </span>
            )}

            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h4 class="text-lg font-semibold text-neutral-900 dark:text-neutral-50">
                {job.role}
              </h4>
              <span class="text-base text-neutral-700 dark:text-neutral-300">
                @ {job.company}
              </span>
              {job.current && (
                <span
                  class="rounded-full bg-accent-500/10 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-accent-700 dark:text-accent-300"
                >
                  Current
                </span>
              )}
            </div>

            <div
              class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs text-neutral-500 dark:text-neutral-500"
            >
              <span class="inline-flex items-center gap-1.5">
                <Briefcase class="h-3 w-3" />
                {job.period}
              </span>
              <span class="inline-flex items-center gap-1.5">
                <MapPin class="h-3 w-3" />
                {job.location}
              </span>
            </div>

            <ul class="mt-4 space-y-2 text-sm leading-relaxed text-neutral-700 dark:text-neutral-300">
              {job.highlights.map((h) => (
                <li class="flex gap-3">
                  <span
                    aria-hidden="true"
                    class="mt-2 h-1 w-1 flex-shrink-0 rounded-full bg-accent-500"
                  >
                  </span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
